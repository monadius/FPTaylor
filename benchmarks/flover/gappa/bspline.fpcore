(FPCore (u)
  :name "bspline0"
  :description "Generated by FPTaylor"
  :precision binary64
  :pre (and (<= 0 u 1))
  (/ (* (* (- 1 u) (- 1 u)) (- 1 u)) 6))

(FPCore (u)
  :name "bspline1"
  :description "Generated by FPTaylor"
  :precision binary64
  :pre (and (<= 0 u 1))
  (/ (+ (- (* (* (* 3 u) u) u) (* (* 6 u) u)) 4) 6))

(FPCore (u)
  :name "bspline2"
  :description "Generated by FPTaylor"
  :precision binary64
  :pre (and (<= 0 u 1))
  (/ (+ (+ (+ (* (* (* (- 3) u) u) u) (* (* 3 u) u)) (* 3 u)) 1) 6))

(FPCore (u)
  :name "bspline3"
  :description "Generated by FPTaylor"
  :precision binary64
  :pre (and (<= 0 u 1))
  (/ (* (* (- u) u) u) 6))

